<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml — used by android:dataExtractionRules (Android 12+).
    Cloud backups and device transfers keep player prefs; WebView cache is not
    worth migrating.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="webview" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="webview" path="." />
    </device-transfer>
</data-extraction-rules>
